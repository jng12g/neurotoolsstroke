    </p>
    <p style="margin-top: 24px;">NEUROTOOLS · v. 2026.05 · © Dr. Juan Carlos Navarro García</p>
  </footer>
</div>

<!-- Estructura oculta si js/ui.js requiere el modal original (mantenida por compatibilidad) -->
<div style="display:none;">
  <div id="popUpTitle"><h2>Sobre esta calculadora</h2></div>
  <div id="popupContent">
    <div class="popcontent">
      <p>Consultar bloque de información en la página principal.</p>
    </div>
  </div>
  <div id="infobutton"></div>
</div>

<script src="js/ui.js"></script>
<script src="js/aed-calc.js"></script>
</body>
</html>
